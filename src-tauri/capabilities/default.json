[
  {
    "identifier": "default",
    "description": "Default capabilities for the app",
    "windows": ["main", "translator-*", "ocr-guide-*"],
    "permissions": [
      "core:default",
      "core:window:default",
      "core:window:allow-create",
      "core:window:allow-close",
      "core:window:allow-hide",
      "core:window:allow-show",
      "core:window:allow-minimize",
      "core:window:allow-unminimize",
      "core:window:allow-set-position",
      "core:window:allow-set-size",
      "core:window:allow-set-always-on-top",
      "core:window:allow-set-focus",
      "core:window:allow-start-dragging",
      "core:webview:default",
      "dialog:default",
      "shell:default",
      "shell:allow-open"
    ]
  },
  {
    "identifier": "scraper",
    "description": "Remote web-scraping translate windows: emit scraper results back to the Rust backend",
    "windows": ["scraper-*"],
    "remote": {
      "urls": ["https://fanyi.qq.com", "https://fanyi.youdao.com"]
    },
    "permissions": ["core:event:allow-emit"]
  }
]
