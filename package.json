{
  "name": "ame",
  "version": "0.5.12",
  "description": "Ame - Visual Novel Translator",
  "author": "nzh63",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzh63/Ame.git"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "AME_LOG=1 tauri dev",
    "tauri:build": "tauri build",
    "dev:render": "vite --config config/vite.tauri.config.mts",
    "build:render": "vite build --config config/vite.tauri.config.mts",
    "build:rs": "yarn build:render && cargo build --manifest-path src-tauri/Cargo.toml",
    "build:e2e": "yarn build:rs",
    "build": "yarn build:rs",
    "dev": "yarn tauri:dev",
    "lint": "eslint . --ignore-path .gitignore --ext .ts,.mts,.js,.vue --fix",
    "style": "prettier --write \"./**/*.{js,ts,css,json,vue}\"",
    "format:check": "prettier --check \"./**/*.{js,ts,css,json,vue}\"",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "yarn test:rs \"$@\"",
    "e2e": "yarn build:e2e && playwright test",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.7",
    "@types/shell-quote": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "eslint": "^8.57.1",
    "eslint-config-alloy": "^5.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.20.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "shell-quote": "^1.8.3",
    "tdesign-icons-vue-next": "^0.3.6",
    "tdesign-vue-next": "^1.14.1",
    "typescript": "^5.8.3",
    "unplugin-vue-components": "^28.7.0",
    "uuid": "^14.0.0",
    "vite": "^7.3.2",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^9.4.3",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  },
  "packageManager": "yarn@4.9.2",
  "resolutions": {
    "whatwg-url@npm:^5.0.0": "npm:12.0.1"
  }
}
